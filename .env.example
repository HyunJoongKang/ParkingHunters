# Cloudtype 배포 시 이 파일의 키들을 Cloudtype 콘솔 > 프로젝트 > 환경 변수에 등록한다.
# 파일 자체를 서버에 올리는 게 아니라, 콘솔에 값만 입력하는 용도의 목록이다.
# 로컬 개발용 값은 이 파일을 복사하지 말고 .env.local.example을 참고할 것.

# 카카오 개발자센터(developers.kakao.com) > 내 애플리케이션 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > JavaScript 키 (REST API 키와 다름)
# 브라우저에 그대로 노출되는 공개 키. 콘솔의 [플랫폼] 설정에 배포 도메인(예:
# https://your-app.cloudtype.app)을 Web 플랫폼으로 등록해야 지도/검색 기능이 동작한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 공공데이터포털(data.go.kr) > 마이페이지 > Open API 활용신청 현황 > 전국주차장정보표준데이터
# 이미 URL 인코딩된 일반 인증키이므로 요청 URL에 그대로(재인코딩 없이) 붙여서 사용한다.
DATA_GO_KR_PARKING_SERVICE_KEY=
# 기본값(코드 내 DEFAULT_API_BASE)을 쓰지 않고 엔드포인트를 바꿔야 할 때만 채운다. 보통 비워 둔다.
DATA_GO_KR_PARKING_ENDPOINT=

# 대구광역시 통합주차정보시스템(pis.daegu.go.kr) — 신청/승인 기반 API.
# https://pis.daegu.go.kr/opendata/apiDetailInfo?api_cd=API001002001
# 기본정보(주차장 목록/요금/운영시간). 이 API가 해외 IP를 차단해서 Cloudtype(국내 리전)
# 배포로 옮기는 것 — Cloudtype 서버 자체가 국내 IP이므로 정상적으로는 프록시 없이도 통과된다.
DAEGU_PARKING_INFO_KEY=
DAEGU_PARKING_INFO_ENDPOINT=

# 실시간 혼잡도/잔여 면수 — 신청 시 등록한 "특정 IP"만 허용하는 화이트리스트 방식이다.
# 국내/해외 여부와 무관하게, Cloudtype이 실제로 사용하는 아웃바운드 IP를 대구시 쪽에
# 별도로 등록해야 401이 나지 않는다. Cloudtype에 고정 아웃바운드 IP가 없다면 기존처럼
# FIXIE_URL 같은 고정 IP 프록시가 계속 필요할 수 있다.
# 기본정보와는 별도로 승인/발급되는 키이므로 DAEGU_PARKING_INFO_KEY와 혼동하지 않는다.
DAEGU_PARKING_CONGESTION_KEY=
DAEGU_PARKING_CONGESTION_ENDPOINT=

# 고정 IP 프록시(예: Fixie, https://usefixie.com) URL. 위 혼잡도 API의 IP 화이트리스트
# 문제가 Cloudtype에서도 남아 있을 때만 설정한다. 형식:
# http://fixie:TOKEN@SUBDOMAIN.usefixie.com:80
# Cloudtype이 고정 아웃바운드 IP를 제공/등록 가능하다면 이 값은 비워 둬도 된다.
FIXIE_URL=

# Cloudtype이 컨테이너에 자동으로 주입하는 포트 번호. 보통 직접 설정할 필요는 없다
# (Dockerfile의 기본값 3000이 next start / standalone server.js에 그대로 쓰인다).
# 콘솔의 "포트" 설정이 이 값과 일치하는지만 확인한다.
PORT=3000
