# 이 파일을 복사해서 .env.local 로 저장하고 실제 발급받은 키를 채워 넣으세요.
# .env.local 은 .gitignore에 이미 포함되어 있어 git에 올라가지 않습니다.

# 카카오 개발자센터(developers.kakao.com) > 내 애플리케이션 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > JavaScript 키 (REST API 키와 다름)
# 브라우저에 그대로 노출되는 공개 키. 콘솔의 [플랫폼] 설정에 http://localhost:3000을
# Web 플랫폼으로 등록해야 지도/검색 기능이 정상 동작합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 공공데이터포털(data.go.kr) > 마이페이지 > Open API 활용신청 현황 > 전국주차장정보표준데이터
# 이미 URL 인코딩된 일반 인증키이므로 요청 URL에 그대로(재인코딩 없이) 붙여서 사용한다.
DATA_GO_KR_PARKING_SERVICE_KEY=
# 기본값(DEFAULT_API_BASE)을 쓰지 않고 엔드포인트를 바꿔야 할 때만 채운다. 보통 비워 둔다.
DATA_GO_KR_PARKING_ENDPOINT=

# 대구광역시 통합주차정보시스템(pis.daegu.go.kr) — 신청/승인 기반 API. 상세:
# https://pis.daegu.go.kr/opendata/apiDetailInfo?api_cd=API001002001
# 기본정보(주차장 목록/요금/운영시간)
DAEGU_PARKING_INFO_KEY=
DAEGU_PARKING_INFO_ENDPOINT=
# 실시간 혼잡도/잔여 면수 — 신청 시 등록한 IP만 허용하는 화이트리스트 방식이라, 서버리스
# 배포(Vercel 등)에서는 FIXIE_URL 같은 고정 IP 프록시 없이는 401이 날 수 있다.
# 기본정보와는 별도로 승인/발급되는 키이므로 DAEGU_PARKING_INFO_KEY와 혼동하지 않는다.
DAEGU_PARKING_CONGESTION_KEY=
DAEGU_PARKING_CONGESTION_ENDPOINT=

# 고정 IP 프록시(예: Fixie, https://usefixie.com) URL. 설정하면 대구시 API 호출이 이
# 프록시를 거쳐 나가 항상 같은 고정 IP로 보인다 — 대구시 실시간 API에 등록해야 하는 IP가
# 바로 이 프록시가 발급한 고정 IP다. 형식: http://fixie:TOKEN@SUBDOMAIN.usefixie.com:80
# 로컬 개발에서는 보통 비워 둬도 된다(로컬 IP가 이미 등록돼 있다면).
FIXIE_URL=
